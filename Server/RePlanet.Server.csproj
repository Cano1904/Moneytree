<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dedizierter Koop-Server für RE:PLANET: reines .NET 8, ohne Unity. Nutzt dieselbe Spiellogik (Core) wie das Spiel. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RePlanet.Server</AssemblyName>
    <RootNamespace>RePlanet.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Nur die hier genannten Dateien kompilieren (SmokeTest/ liegt darunter und ist ein eigenes Projekt). -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RePlanet/Assets/RePlanet/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
