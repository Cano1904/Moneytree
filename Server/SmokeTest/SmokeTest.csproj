<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rauchtest für den dedizierten Server: zwei echte TCP-Clients (GameClient + TcpClientTransport aus Core). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RePlanet.SmokeTest</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../RePlanet/Assets/RePlanet/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="SmokeTest.cs" />
  </ItemGroup>
</Project>
