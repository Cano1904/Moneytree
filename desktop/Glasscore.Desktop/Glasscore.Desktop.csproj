<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GLASSCORE Desktop: standalone Windows/Linux client built on raylib. Shares the simulation and
    netcode sources with the Unity project and the dedicated server, so all three interoperate.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GLASSCORE</AssemblyName>
    <RootNamespace>Glasscore.Desktop</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Glasscore/Assets/Scripts/Simulation/**/*.cs" Link="Simulation/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Glasscore/Assets/Scripts/Net/**/*.cs" Link="Net/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>
</Project>
