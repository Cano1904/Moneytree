<Item RNoPart="0040"><Qty>42.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p><span>Hochbord H 15/30, gerade, grau.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Hochbordstein 100/30/15 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item>
<Item RNoPart="0050"><Qty>74.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Frostschutzmaterial 0/32, Schichtdicke 30 cm, liefern und einbauen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Frostschutzschicht 0/32</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item>
