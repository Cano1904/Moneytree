<Project Sdk="Microsoft.NET.Sdk">
  <!-- Erzeugt docs/WIRTSCHAFT.md aus den Spieldaten (GameData, WorldGen). Aufruf aus dem Wurzelordner: dotnet run (Projekt Tools/DocGen) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RePlanet.DocGen</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../RePlanet/Assets/RePlanet/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
