<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;CS0649;CS0414;CS0169;CS0660;CS0661</NoWarn>
    <Src>$(MSBuildThisFileDirectory)../../RePlanet/Assets/RePlanet</Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Src)/Core/**/*.cs" />
    <Compile Include="$(Src)/Runtime/Render/MeshKit.cs;$(Src)/Runtime/Render/Backdrop.cs;$(Src)/Runtime/Render/WorldView.cs;$(Src)/Runtime/Render/WorldViewProps.cs;$(Src)/Runtime/Render/WorldViewBuildings.cs;$(Src)/Runtime/Render/WorldViewBase.cs;$(Src)/Runtime/Render/WorldViewPropsDetail.cs;$(Src)/Runtime/Render/Mats.cs;$(Src)/Runtime/Render/TrashRenderer.cs;$(Src)/Runtime/Render/FloraRenderer.cs;$(Src)/Runtime/Render/SurfaceLook.cs" />
    <Compile Include="UnityStub.cs;GameStub.cs;Program.cs" />
  </ItemGroup>
</Project>
